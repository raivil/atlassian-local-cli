WIKI_URL=https://wiki.example.com/
WIKI_USERNAME=your-username
WIKI_TOKEN=your-token-here

# Jira auth is chosen by URL:
#   *.atlassian.net  -> Atlassian Cloud: basic auth, needs JIRA_USERNAME + an API token
#   anything else    -> Server/Data Center: Bearer auth with a Personal Access Token
JIRA_URL=https://jira.example.com/
JIRA_TOKEN=your-token-here

# Cloud only: your Atlassian account email. Leave unset on Server/Data Center.
# Create an API token at:
#   https://support.atlassian.com/atlassian-account/docs/manage-api-tokens-for-your-atlassian-account/
# JIRA_USERNAME=you@example.com

# Override the URL-based detection above. Only needed for Cloud on a custom
# domain, which the *.atlassian.net check can't recognise. basic | bearer
# JIRA_AUTH=basic

# Multi-account / context support
# ----------------------------------------------------------------------------
# This file (~/.config/atlassian-local-cli/.env) is the "default" context.
# Additional contexts live at: ~/.config/atlassian-local-cli/contexts/<name>.env
#
# Create one (prompts for anything you don't pass; tokens are read without echo):
#     atlassian-local-cli context add work
#
# Pick one for a single command:
#     atlassian-local-cli --context work jira-get FOO-1
#
# Make a named context the persistent default:
#     atlassian-local-cli context use work
#
# Inspect or list:
#     atlassian-local-cli context list
#     atlassian-local-cli context show work
#
# Note: shell environment variables override values in these files, so an
# exported JIRA_TOKEN in your shell profile will defeat every context.
